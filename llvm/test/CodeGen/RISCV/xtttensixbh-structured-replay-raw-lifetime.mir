# RUN: FileCheck %s --check-prefix=CASE2 --input-file=%t/automatic_reuses_dead_raw.out.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare,riscv-tensix-explicit-replay,riscv-tensix-replay-template-finalize,riscv-tensix-explicit-replay,riscv-tensix-bound-verify %t/automatic_avoids_future_raw_write.mir -o %t/automatic_avoids_future_raw_write.out.mir
# RUN: FileCheck %s --check-prefix=CASE3 --input-file=%t/automatic_avoids_future_raw_write.out.mir
