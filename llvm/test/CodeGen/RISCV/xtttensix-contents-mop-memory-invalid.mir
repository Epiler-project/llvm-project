# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -O2 -verify-machineinstrs -stop-before=riscv-tensix-replay-template-prepare %t/seed.ll -o %t/seed.mir
# RUN: %python %t/mutate.py %t/seed.mir %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare -verify-machineinstrs %t/store_stack.mir -o /dev/null
