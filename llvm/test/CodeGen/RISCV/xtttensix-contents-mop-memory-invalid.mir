# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/wait_zero_scratch.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=SCRATCH
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/wait_precise_memory.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=OWNER
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/response_precise_memory.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RESPONSE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/store_missing_memory.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/store_wrap_offset.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/store_negative_offset.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/reset_missing_config.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING-CONFIG
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/reset_duplicate_issue.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not --crash llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/reset_explicit_operand.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RESET
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixwh -O2 -verify-machineinstrs -stop-before=riscv-tensix-replay-template-prepare %t/seed.ll -o %t/seed.mir
# RUN: %python %t/mutate.py %t/seed.mir %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare -verify-machineinstrs %t/store_stack.mir -o /dev/null
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/wait_missing_issue.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING-ISSUE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/wait_duplicate_issue.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/wait_overlap.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=OVERLAP
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/wait_zero_scratch.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=SCRATCH
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/wait_precise_memory.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=OWNER
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/response_precise_memory.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RESPONSE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/store_missing_memory.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/store_wrap_offset.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/store_negative_offset.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/store_cross_end.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRITE

# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/reset_missing_config.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING-CONFIG
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/reset_duplicate_issue.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not --crash llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-replay-template-prepare %t/reset_explicit_operand.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RESET

# The MOP receiver independently checks complete machine effects, earlyclobber
# scratch ownership and exact memory ranges. No parser flag or pseudo name can
# weaken the fixed-address synchronization owner into an aliasable MMIO access.
# EFFECTS: physical effects differ from the native descriptor
# MISSING-CONFIG: missing implicit register operand 'implicit $tt_config'
# MISSING-ISSUE: missing implicit register operand 'implicit $tt_issue'
# OVERLAP: early-clobber operand overlaps another operand
# SCRATCH: scalar scratch must be writable
# OWNER: coprocessor wait requires one indivisible full-memory machine owner
# RESET: Extra explicit operand on non-variadic instruction
# RESPONSE: read response requires a nonwriting dependency consumer
# WRITE: contents MOP profile cannot admit unknown scalar writes

#--- mutate.py
from pathlib import Path
import re
import sys
source = Path(sys.argv[1]).read_text()
out = Path(sys.argv[2])
wait = next(line for line in source.splitlines(True)
            if " = PseudoTTCoprocessorWait " in line)
response = next(line for line in source.splitlines(True)
                if re.match(r"\s+PseudoTTReadResponse ", line))
reset = next(line for line in source.splitlines(True)
             if "PseudoTTSFPMacroAddressReset " in line)
store = next(line for line in source.splitlines(True)
             if re.search(r"\bSW .*inttoptr \(i32 1048832 to ptr\)", line))
memory = store[store.index(" :: "):].rstrip()
use = re.search(r", implicit \$tt_issue\b", wait)
assert use
missing = wait[:use.start()] + wait[use.end():]
regs = re.findall(r"%[0-9]+:gpr", wait)
assert len(regs) == 2
# Physical scratch overlap remains valid machine SSA, so this reaches the
# target operand verifier instead of failing the MIR parser on a virtual
# register's duplicate definition.
overlap_wait = wait.replace(regs[0], "$x11").replace(regs[1], "$x11")
value = re.search(r"SW (%[0-9]+)", store).group(1)
stack = source.replace(store, f"    SW {value}, %stack.0, 0 :: (store (s32) into %stack.0)\n")
stack = stack.replace("stack:           []", "stack:\n  - { id: 0, size: 4, alignment: 4 }")
variants = {
    "reset_missing_config": source.replace(reset, reset.replace(", implicit $tt_config", "")),
    "reset_duplicate_issue": source.replace(reset, reset.replace(" :: ", ", implicit $tt_issue :: ")),
    "reset_explicit_operand": source.replace(reset, reset.replace("PseudoTTSFPMacroAddressReset ", "PseudoTTSFPMacroAddressReset 0, ")),
    "store_stack": stack,
    "wait_missing_issue": source.replace(wait, missing),
    "wait_duplicate_issue": source.replace(wait, wait.rstrip() + ", implicit $tt_issue\n"),
    "wait_overlap": source.replace(wait, overlap_wait),
    "wait_zero_scratch": source.replace(wait, wait.replace(regs[1], "$x0")),
    "wait_precise_memory": source.replace(wait, wait.rstrip() + memory + "\n"),
    "response_precise_memory": source.replace(response, response.rstrip() + memory + "\n"),
    "store_missing_memory": source.replace(store, store[:store.index(" :: ")] + "\n"),
    "store_wrap_offset": source.replace(store, store.replace("to ptr)`)", "to ptr)` + 4293918464)")),
    "store_negative_offset": source.replace(store, store.replace("to ptr)`)", "to ptr)` - 1048833)")),
    "store_cross_end": source.replace(store, store.replace("1048832", "1499135")),
}
for name, contents in variants.items():
    assert contents != source, name
    (out / (name + ".mir")).write_text(contents)

#--- seed.ll
target triple = "riscv32-unknown-elf"
declare void @llvm.riscv.tt.contents.encc(i32 immarg, i32 immarg)
declare void @llvm.riscv.tt.contents.config.reset()
declare <32 x i32> @llvm.riscv.tt.contents.read.constant(i32 immarg)
declare <32 x i32> @llvm.riscv.tt.contents.iadd(<32 x i32>, <32 x i32>, i32 immarg)
declare void @llvm.riscv.tt.contents.store(<32 x i32>, i32, i32 immarg, i32 immarg)
declare void @llvm.riscv.tt.contents.replay.template.begin(i32 immarg, i32 immarg, i32 immarg, i32 immarg, i32 immarg, ...)
declare void @llvm.riscv.tt.contents.replay.template.end(i32 immarg, ...)
declare void @llvm.riscv.tt.contents.replay.template.record.iadd(i32 immarg, i32 immarg, i32 immarg)
declare { <32 x i32> } @llvm.riscv.tt.contents.replay.template.execute.sl_v32i32s(i32 immarg, i32 immarg, ...)
declare void @llvm.riscv.tt.contents.replay.template.mop(i32 immarg, i32 immarg)
declare { <32 x i32> } @llvm.riscv.tt.contents.replay.template.mop.execute.sl_v32i32s(i32 immarg, i32 immarg, ...)
declare void @llvm.riscv.tt.mop.control.write(i32 immarg, i32)
declare void @llvm.riscv.tt.mop.clear(i32 immarg)
declare void @llvm.riscv.tt.mop(i32 immarg, i32 immarg, i32 immarg)
declare void @llvm.riscv.tt.mop.port(i32 immarg, i32, i32, i32)

declare void @llvm.riscv.tt.read.response(i32)
declare void @llvm.riscv.tt.coprocessor.wait()
declare void @llvm.riscv.tt.contents.macro.address.reset()
define void @local_l1(ptr %unknown, i32 %value) "tensix-executor"="trisc1" {
entry:
  call void @llvm.riscv.tt.contents.encc(i32 3, i32 10)
  call void @llvm.riscv.tt.contents.config.reset()
  %old = call <32 x i32> @llvm.riscv.tt.contents.read.constant(i32 9)
  %capture = call <32 x i32> @llvm.riscv.tt.contents.read.constant(i32 15)
  call void (i32, i32, i32, i32, i32, ...) @llvm.riscv.tt.contents.replay.template.begin(i32 71, i32 0, i32 0, i32 0, i32 1, <32 x i32> %old, <32 x i32> %capture)
  call void @llvm.riscv.tt.contents.replay.template.record.iadd(i32 71, i32 0, i32 1)
  call void (i32, ...) @llvm.riscv.tt.contents.replay.template.end(i32 71, <32 x i32> %old)
  call void @llvm.riscv.tt.contents.store(<32 x i32> %old, i32 0, i32 0, i32 4)
  call void @llvm.riscv.tt.mop.control.write(i32 0, i32 1)
  call void @llvm.riscv.tt.mop.control.write(i32 1, i32 4)
  call void @llvm.riscv.tt.mop.clear(i32 2)
  call void @llvm.riscv.tt.mop.clear(i32 3)
  call void @llvm.riscv.tt.mop.clear(i32 4)
  call void @llvm.riscv.tt.contents.replay.template.mop(i32 71, i32 5)
  call void @llvm.riscv.tt.mop.clear(i32 6)
  call void @llvm.riscv.tt.contents.replay.template.mop(i32 71, i32 7)
  call void @llvm.riscv.tt.mop.clear(i32 8)
  %first.mop = call { <32 x i32> } (i32, i32, ...) @llvm.riscv.tt.contents.replay.template.mop.execute.sl_v32i32s(i32 71, i32 1, <32 x i32> %old, <32 x i32> %capture)
  %first = extractvalue { <32 x i32> } %first.mop, 0
  call void @llvm.riscv.tt.contents.store(<32 x i32> %first, i32 2, i32 0, i32 4)
  store volatile i32 %value, ptr inttoptr (i32 1048832 to ptr), align 4
  call void @llvm.riscv.tt.contents.macro.address.reset()
  call void @llvm.riscv.tt.coprocessor.wait()
  call void @llvm.riscv.tt.read.response(i32 %value)
  %second.mop = call { <32 x i32> } (i32, i32, ...) @llvm.riscv.tt.contents.replay.template.mop.execute.sl_v32i32s(i32 71, i32 1, <32 x i32> %first, <32 x i32> %capture)
  %second = extractvalue { <32 x i32> } %second.mop, 0
  call void @llvm.riscv.tt.contents.store(<32 x i32> %second, i32 4, i32 0, i32 4)
  ret void
}
