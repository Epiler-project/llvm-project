# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare %t/wait_duplicate_issue.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
