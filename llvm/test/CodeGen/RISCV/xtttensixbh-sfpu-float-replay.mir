# RUN: split-file %s %t
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/input.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=HAZARD
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -start-before=riscv-tensix-hazards -stop-after=riscv-tensix-hazards %t/input.mir -o %t/repaired.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-selection %t/repaired.mir -o %t/selected.mir
# RUN: FileCheck %s --check-prefix=SELECT < %t/selected.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -riscv-tensix-enable-replay-selection=false -run-pass=riscv-tensix-replay-selection %t/repaired.mir -o %t/plain.mir
# RUN: %python %t/check.py %t/repaired.mir %t/selected.mir %t/plain.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-hazards %t/selected.mir -o %t/final.mir
# RUN: %python %t/check.py %t/repaired.mir %t/final.mir %t/plain.mir
# RUN: %python %t/mutate.py %t/selected.mir %t
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/missing-old.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/missing-fixed.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/missing-cc.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/missing-def.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/extra-def.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/entry-hazard.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=HAZARD
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/exit-hazard.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=HAZARD
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-hazards %t/unrelated-exit.mir -o /dev/null
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/internal-hazard.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=HAZARD
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -start-before=riscv-tensix-hazards -stop-after=riscv-tensix-hazards %t/internal-hazard.mir -o %t/count-drift.mir
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/count-drift.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=COUNT
# HAZARD: unresolved Tensix SFPU MAD to IADD destination hazard
# EFFECTS: automatic SFPU replay execution physical effects differ from its recording
# COUNT: Tensix replay final issue count 9 differs from declared length 8
#
# Exact authored operations, old destination ties, fixed C9/C10, mutable CRegs,
# CC/config/issue and live-through L7 must survive compression. The independent
# checker expands only the hardware replay buffer and compares the issued
# stream and CFG, never synthesizing source iterations or evaluating floats.
# Repair runs before selection: the second case records nine issues, including
# three MAD-pipeline gaps. Mutations separately probe the replay entry, precise
# two-cycle tail, internal gaps, physical effects, and post-repair issue count.
# Capacity, both charged fences, predicate/Dst boundaries and the real backedge
# remain unchanged. Dst accesses are deliberately outside the record.
#
# SELECT-LABEL: name: float_physical
# SELECT: PseudoTTSFPUReplay 1, 1, 7, 0,
# SELECT-NEXT: $tt_l0 = TTSFPIADD $tt_l0, $tt_c9,
# SELECT-NEXT: $tt_l0 = TTSFPADD $tt_l0, $tt_l1, $tt_c11, 1,
# SELECT-NEXT: $tt_l2 = TTSFPMUL $tt_l2, $tt_l3, $tt_c12, 2,
# SELECT-NEXT: $tt_l4 = TTSFPMAD $tt_l4, $tt_l5, $tt_l6, $tt_c13, 3,
# SELECT-NEXT: $tt_l0 = TTSFPADD $tt_l0, $tt_l1, $tt_c11, 0,
# SELECT-NEXT: $tt_l2 = TTSFPMUL $tt_l2, $tt_l3, $tt_c12, 1,
# SELECT-NEXT: $tt_l4 = TTSFPMAD $tt_l4, $tt_l5, $tt_l6, $tt_c13, 2,
# SELECT-NEXT: PseudoTTReplayRecordEnd
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: PseudoTTSFPUReplay 0, 0, 7, 0,
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: TTSFPSTORE $tt_l7,
# SELECT-LABEL: name: post_hazard_count
# SELECT: PseudoTTSFPUReplay 1, 1, 9, 0,
# SELECT-NEXT: $tt_l0 = TTSFPADD
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: $tt_l0 = TTSFPIADD
# SELECT-NEXT: $tt_l2 = TTSFPMUL
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: $tt_l2 = TTSFPIADD
# SELECT-NEXT: $tt_l4 = TTSFPMAD
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: $tt_l4 = TTSFPIADD
# SELECT-NEXT: PseudoTTReplayRecordEnd
# SELECT: PseudoTTSFPUReplay 0, 0, 9, 0,

#--- input.mir
--- |
  define void @float_physical() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @post_hazard_count() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_break_even() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_extra_effect() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_predicate_boundary() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_dst_boundary() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_explicit_owner() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_capacity_32() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_capacity_33() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @float_real_backedge() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...

---
name: float_physical
tracksRegLiveness: true
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    liveins: $tt_l0, $tt_l1, $tt_l2, $tt_l3, $tt_l4, $tt_l5, $tt_l6, $tt_l7, $tt_c11, $tt_c12, $tt_c13, $tt_cc, $tt_config, $tt_dst, $tt_issue, $x10
    $tt_l0 = TTSFPIADD $tt_l0, $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPADD $tt_l0, $tt_l1, $tt_c11, 1, implicit $tt_c10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMUL $tt_l2, $tt_l3, $tt_c12, 2, implicit $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPMAD $tt_l4, $tt_l5, $tt_l6, $tt_c13, 3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPADD $tt_l0, $tt_l1, $tt_c11, 0, implicit $tt_c10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMUL $tt_l2, $tt_l3, $tt_c12, 1, implicit $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPMAD $tt_l4, $tt_l5, $tt_l6, $tt_c13, 2, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPIADD $tt_l0, $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPADD $tt_l0, $tt_l1, $tt_c11, 1, implicit $tt_c10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMUL $tt_l2, $tt_l3, $tt_c12, 2, implicit $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPMAD $tt_l4, $tt_l5, $tt_l6, $tt_c13, 3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPADD $tt_l0, $tt_l1, $tt_c11, 0, implicit $tt_c10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMUL $tt_l2, $tt_l3, $tt_c12, 1, implicit $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPMAD $tt_l4, $tt_l5, $tt_l6, $tt_c13, 2, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    TTSFPSTORE $tt_l7, 0, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...

