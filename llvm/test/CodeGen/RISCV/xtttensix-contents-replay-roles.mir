    PseudoRET
...

# The fixed descriptor owns every old/result tie. A contradictory explicit
# tie naming the identity operand is rejected by the MIR parser before a pass.
#--- wrong-tie.mir
--- |
  target triple = "riscv32"
  define void @roles() "tensix-executor"="trisc1" { ret void }
...
---
name: roles
tracksRegLiveness: true
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: false
body: |
  bb.0:
    liveins: $tt_c9, $tt_c10, $tt_c15, $tt_config, $tt_issue, $tt_cc
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l1 = TTSFPMOVAll $tt_c10, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMOVAll $tt_c15, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTContentsReplayTemplateBegin 62, 1, 0, 0, 2, $tt_l0, $tt_l1, $tt_l2, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPIADD $tt_l0, $tt_l2, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l1 = TTSFPXOR $tt_l1, $tt_l2, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTContentsReplayTemplateEnd 62, $tt_l0, $tt_l1, implicit $tt_issue, implicit-def $tt_issue
    early-clobber $tt_l0, early-clobber $tt_l1 = PseudoTTContentsReplayTemplateExecute2 62, 2, $tt_l0(tied-def 2), $tt_l1, $tt_l2, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoRET
...

# The second result deliberately omits its early-clobber marker, and both
# old operands omit redundant tied-def text. The fixed descriptor restores
# the flag and ties during MIR construction; verify and print that result.
#--- missing-early.mir
