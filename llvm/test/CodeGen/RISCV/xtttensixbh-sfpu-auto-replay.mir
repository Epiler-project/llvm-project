#--- check-replay.py
import re
import sys


def read(path):
    functions = {}
    current = None
    in_body = False
    for line in open(path, encoding="utf-8"):
        match = re.fullmatch(r"name:\s+(\w+)\s*", line.strip())
        if match:
            current = match.group(1)
            functions[current] = []
            in_body = False
        if line.startswith("body:"):
            in_body = True
            continue
        if not in_body or current is None:
            continue
        text = line.strip()
        if text == "...":
            in_body = False
            continue
        if not text or text.startswith(("liveins:", "successors:")):
            continue
        if text.startswith("bb."):
            functions[current].append(("block", text, (), (), ()))
            continue
        match = re.search(r"\b(TTSFP\w+|TTREPLAY|TTNOP|Pseudo\w+|BNE)\b", text)
        assert match, (path, current, text)
        opcode = match.group(1)
        defs = tuple(re.findall(r"\$[\w]+", text[:match.start()]))
        operands = text[match.end():].split(", implicit", 1)[0].strip()
        operands = re.sub(r"\b(killed|dead|renamable)\s+", "", operands)
        args = tuple(operand.strip() for operand in operands.split(",") if operand.strip())
        uses = tuple(re.findall(r"implicit\s+(?:killed\s+)?(\$\w+)", text))
        clobbers = tuple(re.findall(r"implicit-def\s+(?:dead\s+)?(\$\w+)", text))
        functions[current].append((opcode, defs, args, uses, clobbers))
    return functions


def expand(instructions):
    # Model the hardware buffer and record/execute controls independently of
    # the compiler's candidate search or register-effect calculation.
    bank = [None] * 32
    recording = None
    result = []
    for instruction in instructions:
        opcode, defs, args, uses, clobbers = instruction
        if opcode in ("TTREPLAY", "PseudoTTSFPUReplay"):
            load, execute, length, start = map(int, args)
            assert 0 < length <= 32 and 0 <= start <= 32 - length
            assert recording is None
            if load:
                recording = [start, length, execute, 0]
            else:
                assert all(value is not None for value in bank[start:start + length])
                result.extend(bank[start:start + length])
            continue
        if opcode == "PseudoTTReplayRecordEnd":
            assert recording is not None and recording[1] == recording[3]
            recording = None
            continue
        encoded = (opcode, defs, args)
        if recording is not None:
            assert opcode.startswith(("TTSFP", "TTNOP")), instruction
            start, length, execute, count = recording
            assert count < length
            bank[start + count] = encoded
            recording[3] += 1
            if execute:
                result.append(encoded)
        else:
            result.append(encoded)
    assert recording is None
    # SFPU NOPs inserted outside recording change spacing, not arithmetic.
    # Final machine hazard verification separately proves their legality.
    return [instruction for instruction in result if instruction[0] != "TTSFPNOP"]


def words(instructions):
    return sum(instruction[0] not in ("block", "PseudoTTReplayRecordEnd")
               for instruction in instructions)


source, selected, plain = map(read, sys.argv[1:])
assert source.keys() == selected.keys() == plain.keys()
for name, before in source.items():
    assert expand(before) == expand(selected[name]), (name, "changed issue stream or CFG")
    assert expand(before) == expand(plain[name]), (name, "disabled selection changed semantics")
    assert not any(instruction[0] == "PseudoTTSFPUReplay" for instruction in plain[name])
    if name in ("capacity_32", "capacity_33"):
        records = [instruction for instruction in selected[name]
                   if instruction[0] == "PseudoTTSFPUReplay"]
        assert len(records) == 2 and all(instruction[2][2] == "32" for instruction in records)
        assert words(selected[name]) == words(before) - 28, (name, "capacity or fence cost")
        continue
    if name != "profitable_physical":
        assert not any(instruction[0] == "PseudoTTSFPUReplay" for instruction in selected[name])
        assert words(selected[name]) == words(before), (name, "unprofitable or unsafe mutation")
        continue
    assert words(selected[name]) == words(before) - 2, "fences must be charged to actual benefit"
    executes = [instruction for instruction in selected[name]
                if instruction[0] == "PseudoTTSFPUReplay" and instruction[2][0] == "0"]
    assert len(executes) == 1
    uses = set(executes[0][3])
    clobbers = set(executes[0][4])
    assert {"$tt_l0", "$tt_l1", "$tt_l2", "$tt_l3", "$tt_l4", "$tt_c9",
            "$tt_cc", "$tt_config", "$tt_issue"} <= uses, uses
    assert {reg for reg in clobbers if re.fullmatch(r"\$tt_l[0-7]", reg)} == {
        "$tt_l0", "$tt_l2", "$tt_l4"}, clobbers
    assert "$tt_cc" not in clobbers and "$tt_l6" not in clobbers, clobbers

#--- mutate.py
import re
import sys
from pathlib import Path


text = Path(sys.argv[1]).read_text()
lines = text.splitlines(keepends=True)
execute = next(i for i, line in enumerate(lines)
               if "PseudoTTSFPUReplay 0, 0, 6, 0," in line)
for path, pattern in zip(sys.argv[2:4], (
        r", implicit-def(?: dead)? \$tt_l4(?=,|\s*$)",
        r", implicit(?: killed)? \$tt_l1(?=,|\s*$)")):
    changed, count = re.subn(pattern, "", lines[execute])
    assert count == 1, (pattern, lines[execute])
    result = lines.copy()
    result[execute] = changed
    Path(path).write_text("".join(result))
changed, count = re.subn(r"PseudoTTSFPUReplay 1, 1, 6, 0,",
                       "PseudoTTSFPUReplay 1, 1, 5, 0,", text, count=1)
assert count == 1
Path(sys.argv[4]).write_text(changed)
