# RUN: split-file %s %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-selection %t/input.mir -o %t/selected.mir
# RUN: FileCheck %s --check-prefix=SELECT < %t/selected.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -riscv-tensix-enable-replay-selection=false -run-pass=riscv-tensix-replay-selection %t/input.mir -o %t/plain.mir
# RUN: %python %t/check-replay.py %t/input.mir %t/selected.mir %t/plain.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-hazards %t/selected.mir -o %t/final.mir
# RUN: %python %t/check-replay.py %t/input.mir %t/final.mir %t/plain.mir
# RUN: %python %t/mutate.py %t/selected.mir %t/missing-def.mir %t/missing-use.mir %t/wrong-length.mir
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/missing-def.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/missing-use.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECTS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/wrong-length.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RECORD-LENGTH
# EFFECTS: automatic SFPU replay execution physical effects differ from its recording
# RECORD-LENGTH: Tensix replay final issue count 6 differs from declared length 5
#
# The input uses only existing instructions, so a preimplementation failure
# must report missing compression, not an unknown opcode or unregistered pass.
# Two six-word sequences cost 12 words. The selected form costs six retained
# words, one record header, one execute and two SFPU fences: ten words.
# The independent checker interprets the replay buffer, compares the complete
# issued arithmetic/control stream, and checks live physical effects and size.
#
# SELECT-LABEL: name: profitable_physical
# SELECT: PseudoTTSFPUReplay 1, 1, 6, 0,
# SELECT-NEXT: $tt_l0 = TTSFPIADD $tt_l0, $tt_l1,
# SELECT-NEXT: $tt_l2 = TTSFPXOR $tt_l2, $tt_l3,
# SELECT-NEXT: $tt_l4 = TTSFPAND $tt_l4, $tt_c9,
# SELECT-NEXT: $tt_l0 = TTSFPOR $tt_l0, $tt_l1,
# SELECT-NEXT: $tt_l2 = TTSFPAND $tt_l2, $tt_l3,
# SELECT-NEXT: $tt_l4 = TTSFPXOR $tt_l4, $tt_c9,
# SELECT-NEXT: PseudoTTReplayRecordEnd
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: PseudoTTSFPUReplay 0, 0, 6, 0,
# SELECT-NEXT: TTSFPNOP
# SELECT-NEXT: TTSFPSTORE $tt_l0, 0, 0, 4,
# SELECT-NEXT: TTSFPSTORE $tt_l2, 1, 0, 4,
# SELECT-NEXT: TTSFPSTORE $tt_l4, 2, 0, 4,
# SELECT-NEXT: TTSFPSTORE $tt_l6, 3, 0, 4,
# SELECT-NEXT: PseudoRET
#
# Four-word pairs only break even once both fences are charged. They are not
# profitable even though the ordinary immediate-only replay cost would be.
# SELECT-LABEL: name: fence_break_even
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: PseudoRET
# SELECT-LABEL: name: different_physical
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: PseudoRET
# SELECT-LABEL: name: predicate_boundary
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: TTSFPSETCCNE
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: PseudoRET
# SELECT-LABEL: name: occupied_explicit
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: TTREPLAY 1, 0, 1, 0,
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: PseudoRET
# SELECT-LABEL: name: real_backedge
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: PseudoBR %bb.1
# SELECT: BNE $x10, $x0, %bb.1
# SELECT-NEXT: PseudoBR %bb.2
# SELECT-NOT: PseudoTTSFPUReplay
# SELECT: PseudoRET

#--- input.mir
--- |
  define void @profitable_physical() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @fence_break_even() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @different_physical() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @predicate_boundary() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @occupied_explicit() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @real_backedge() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @capacity_32() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @capacity_33() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: profitable_physical
tracksRegLiveness: true
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    liveins: $tt_l0, $tt_l1, $tt_l2, $tt_l3, $tt_l4, $tt_l6, $tt_l7, $tt_cc, $tt_config, $tt_dst, $tt_issue
    $tt_l0 = TTSFPIADD $tt_l0, $tt_l1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPXOR $tt_l2, $tt_l3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPAND $tt_l4, $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPOR $tt_l0, $tt_l1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPAND $tt_l2, $tt_l3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPXOR $tt_l4, $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPIADD $tt_l0, $tt_l1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPXOR $tt_l2, $tt_l3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPAND $tt_l4, $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPOR $tt_l0, $tt_l1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPAND $tt_l2, $tt_l3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l4 = TTSFPXOR $tt_l4, $tt_c9, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    TTSFPSTORE $tt_l0, 0, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    TTSFPSTORE $tt_l2, 1, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    TTSFPSTORE $tt_l4, 2, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    TTSFPSTORE $tt_l6, 3, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...
---
