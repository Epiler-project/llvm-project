tracksRegLiveness: true
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: false
body: |
  bb.0:
    successors: %bb.1
    liveins: $tt_c9, $tt_c15, $tt_config, $tt_issue, $tt_cc, $tt_dst, $x10
    %0:sfpr = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    %1:sfpr = TTSFPMOVAll $tt_c15, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTContentsReplayTemplateBegin 41, 1, 0, 0, 1, %0, %1, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    %2:sfpr = TTSFPIADD %0, %1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
