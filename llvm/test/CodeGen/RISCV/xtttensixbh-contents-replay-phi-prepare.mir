    %3:sfpr = PHI %2, %bb.0, %4, %bb.1
    %6:gpr = PHI %5, %bb.0, %7, %bb.1
    %8:sfpr = PHI %1, %bb.0, %8, %bb.1
    early-clobber %4:sfpr = PseudoTTContentsReplayTemplateExecute1 41, 1, %3, %8, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    %7:gpr = ADDI %6, 1
    BLT %7, %9, %bb.1
    PseudoBR %bb.2

  bb.2:
    liveins: $tt_config, $tt_issue, $tt_cc, $tt_dst
    TTSFPSTORE %4, 8, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...

