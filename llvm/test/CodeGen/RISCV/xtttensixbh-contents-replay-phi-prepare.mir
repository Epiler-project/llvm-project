# RUN: split-file %s %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/mutable-phi.mir -o - | FileCheck %s --check-prefix=ACCEPT
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/capture-phi.mir -o - | FileCheck %s --check-prefix=ACCEPT
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/capture-copy.mir -o - | FileCheck %s --check-prefix=ACCEPT
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/foreign-seed.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PROVENANCE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/pre-record-old.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PROVENANCE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/unseeded-phi-cycle.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PROVENANCE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-prepare %t/changed-capture.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PROVENANCE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-replay-template-finalize %t/physical-capture-mismatch.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=PHYSICAL
#
# Pass-local MIR ingress independently verifies semantic contents ancestry.
# COPY/PHI acceptance before allocation never permits a physical repair move.
# Exact physical record-role identity remains required after allocation.
# ACCEPT: :sfpr = PHI
# ACCEPT: PseudoTTContentsReplayTemplateExecute1 41,
# PROVENANCE: contents replay execution lost its recorded SSA contents
# PHYSICAL: contents replay allocation differs from its recorded register roles

#--- mutable-phi.mir
--- |
  target triple = "riscv32"
  define void @contents_replay_loop(i32 %limit) "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: contents_replay_loop
tracksRegLiveness: true
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: false
body: |
  bb.0:
    successors: %bb.1
    liveins: $tt_c9, $tt_c15, $tt_config, $tt_issue, $tt_cc, $tt_dst, $x10
    %0:sfpr = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    %1:sfpr = TTSFPMOVAll $tt_c15, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTContentsReplayTemplateBegin 41, 1, 0, 0, 1, %0, %1, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    %2:sfpr = TTSFPIADD %0, %1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTContentsReplayTemplateEnd 41, %2, implicit $tt_issue, implicit-def $tt_issue
    TTSFPSTORE %2, 0, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    %5:gpr = ADDI $x0, 0
    %9:gpr = COPY $x10
    PseudoBR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $tt_config, $tt_issue, $tt_cc, $tt_dst
    %3:sfpr = PHI %2, %bb.0, %4, %bb.1
    %6:gpr = PHI %5, %bb.0, %7, %bb.1

    early-clobber %4:sfpr = PseudoTTContentsReplayTemplateExecute1 41, 1, %3, %1, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    %7:gpr = ADDI %6, 1
    BLT %7, %9, %bb.1
    PseudoBR %bb.2

  bb.2:
    liveins: $tt_config, $tt_issue, $tt_cc, $tt_dst
    TTSFPSTORE %4, 8, 0, 4, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...

#--- capture-phi.mir
--- |
  target triple = "riscv32"
  define void @contents_replay_loop(i32 %limit) "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
