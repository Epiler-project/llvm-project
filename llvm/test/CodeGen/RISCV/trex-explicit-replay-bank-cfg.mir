# RUN: split-file %s %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -run-pass=riscv-tensix-explicit-replay,riscv-tensix-bound-verify %t/unreachable-predecessor.mir -o %t/normalized.mir
# RUN: %python %t/check.py %t/normalized.mir
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs=false -run-pass=riscv-tensix-explicit-replay %t/entry-backedge.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=ENTRY
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs=false -run-pass=riscv-tensix-explicit-replay %t/unreachable-invalid-record.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=SYNTAX
#
# A dead predecessor remains syntactically checked, but it does not contribute
# bank knowledge to a reachable merge. Its conflicting L1 <- C10 recording must
# not obscure the reachable L0 <- C9 recording or add physical execution effects.
# The entry block starts empty even when a later record reaches it on a backedge:
# a later dynamic iteration cannot initialize the first execution.
#
# ENTRY: Tensix replay execution references slots not recorded on every incoming path
# SYNTAX: Tensix replay recording cannot cross scalar control flow

#--- unreachable-predecessor.mir
--- |
  define void @unreachable_predecessor() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: unreachable_predecessor
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    successors: %bb.2
    TTREPLAY 1, 0, 1, 4, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    TTREPLAY 1, 0, 1, 4, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l1 = TTSFPMOVAll $tt_c10, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.2
  bb.2:
    TTREPLAY 0, 0, 1, 4, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...

#--- entry-backedge.mir
--- |
  define void @entry_backedge() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: entry_backedge
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    TTREPLAY 0, 0, 1, 4, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    BNE $x10, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.0
    TTREPLAY 1, 0, 1, 4, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.0
  bb.2:
    PseudoRET
...

#--- unreachable-invalid-record.mir
--- |
  define void @unreachable_invalid_record() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: unreachable_invalid_record
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    successors: %bb.2
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    TTREPLAY 1, 0, 1, 4, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.2
  bb.2:
    PseudoRET
...

#--- check.py
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text()
body = re.search(r"^body:\s+\|\n(.*?)(?=^\.\.\.)", text,
                 re.MULTILINE | re.DOTALL).group(1)
headers = [line for line in body.splitlines()
           if "PseudoTTExplicitSFPUReplay " in line]
assert len(headers) == 3, headers
execute = [line for line in headers
           if "PseudoTTExplicitSFPUReplay 0, 0, 1, 4," in line]
assert len(execute) == 1, execute
uses = re.findall(r"\bimplicit(?: killed)? \$(\w+)", execute[0])
defs = re.findall(r"\bimplicit-def(?: dead)? \$(\w+)", execute[0])
assert sorted(uses) == ["tt_c9", "tt_config", "tt_issue"], execute[0]
assert sorted(defs) == ["tt_issue", "tt_l0"], execute[0]
assert sum("PseudoTTSFPURecordWord " in line for line in body.splitlines()) == 2
assert "TTREPLAY " not in body, body
assert "TTSFPMOVAll " not in body, body
