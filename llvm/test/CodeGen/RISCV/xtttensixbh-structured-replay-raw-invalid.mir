# RUN: split-file %s %t
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare,riscv-tensix-explicit-replay,riscv-tensix-replay-template-finalize,riscv-tensix-explicit-replay,riscv-tensix-bound-verify %t/fixed_live_template_clobbered.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=CONFLICT
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare,riscv-tensix-explicit-replay,riscv-tensix-replay-template-finalize,riscv-tensix-explicit-replay,riscv-tensix-bound-verify %t/fixed_backedge_template_clobbered.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=CONFLICT
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare,riscv-tensix-explicit-replay,riscv-tensix-replay-template-finalize,riscv-tensix-explicit-replay,riscv-tensix-bound-verify %t/raw_missing_incoming_record.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-template-prepare,riscv-tensix-explicit-replay,riscv-tensix-replay-template-finalize,riscv-tensix-explicit-replay,riscv-tensix-bound-verify %t/raw_different_incoming_words.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WORDS
#
# CONFLICT: structured replay fixed placement conflicts or exceeds capacity
# MISSING: Tensix replay execution references slots not recorded on every incoming path
# WORDS: SFPU replay execution has differing or unknown templates on incoming paths
#
# A raw writer cannot silently replace a still-live structured handle, even
# when the next use is reached only through a backedge. Conversely, admitting
# an unrelated structured template must retain existing raw incoming-path
# checks and exact SFPU word/effect requirements. None of these failures may
# be hidden behind a blanket mixed-ownership rejection.
#
#--- fixed_live_template_clobbered.mir
--- |
  define void @fixed_live_template_clobbered() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: fixed_live_template_clobbered
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    PseudoTTReplayTemplateBegin 601, 0, 1, 0, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMOVAll $tt_c10, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateEnd 601, implicit $tt_issue, implicit-def $tt_issue
    TTREPLAY 1, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateExecute 601, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoRET
...

#--- fixed_backedge_template_clobbered.mir
--- |
  define void @fixed_backedge_template_clobbered() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: fixed_backedge_template_clobbered
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    successors: %bb.1
    PseudoTTReplayTemplateBegin 601, 0, 1, 0, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMOVAll $tt_c10, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateEnd 601, implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    PseudoTTReplayTemplateExecute 601, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    TTREPLAY 1, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    BNE $x10, $x0, %bb.1
    PseudoBR %bb.2
  bb.2:
    PseudoRET
...

#--- raw_missing_incoming_record.mir
--- |
  define void @raw_missing_incoming_record() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: raw_missing_incoming_record
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    PseudoTTReplayTemplateBegin 601, 0, 1, 31, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMOVAll $tt_c10, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateEnd 601, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateExecute 601, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    BNE $x10, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    TTREPLAY 1, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    PseudoBR %bb.3
  bb.3:
    TTREPLAY 0, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...

#--- raw_different_incoming_words.mir
--- |
  define void @raw_different_incoming_words() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: raw_different_incoming_words
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    PseudoTTReplayTemplateBegin 601, 0, 1, 31, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l2 = TTSFPMOVAll $tt_c10, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateEnd 601, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayTemplateExecute 601, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    BNE $x10, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    TTREPLAY 1, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    TTREPLAY 1, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l1 = TTSFPMOVAll $tt_c9, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    PseudoBR %bb.3
  bb.3:
    TTREPLAY 0, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...
