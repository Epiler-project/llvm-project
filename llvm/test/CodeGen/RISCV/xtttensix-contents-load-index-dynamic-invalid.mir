# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -verify-machineinstrs=false -start-before=riscv-tensix-hazards -filetype=obj %t/wh-addrmod.mir -o %t/wh-addrmod.o 2>&1 | FileCheck %s --check-prefix=ADDRMOD
# RUN: test ! -e %t/wh-addrmod.o

# MIRParser unconditionally runs MachineFunction::verify; its precise generic
# class/tie crash and missing-implicit parse error are separate from the target
# receiver's own role, scratch, exact-effects, memory and field diagnostics.
# No flag or parser modification bypasses those earlier validation layers.
# ROLE: bound Tensix SFPU operand does not match its native register role
# GENERIC: Bad machine code: Tied physical registers must match.
# PARSER: missing implicit register operand 'implicit $tt_config'
# OVERLAP: bound Tensix SFPU early-clobber operand overlaps another operand
# WRITABLE: bound Tensix SFPU scalar scratch must be writable
# EFFECTS: bound Tensix SFPU physical effects differ from the native descriptor
# MEMORY: contents paired LOAD port requires its volatile memory effects
# FORMAT: SFPLOADIndex mode must be one of {0, 1, 2, 3, 4, 5, 6, 8, 14, 15}
# ADDRMOD: Wormhole SFPLOADIndex operand 5 must be in [0, 3]

#--- undef-old.mir
--- |
  define void @undef_old() "tensix-executor"="trisc1" { ret void }
...
---
name: undef_old
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    $tt_l0, $tt_l4, early-clobber $x5, early-clobber $x6 = PseudoTTSFPLOADIndex undef $tt_l0, $tt_l4, $x10, 0, 3, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue :: (volatile load store (s32))
    PseudoRET
...


