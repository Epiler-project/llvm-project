# RUN: split-file %s %t
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=postrapseudos %t/copy.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=TIE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=postrapseudos %t/transpose.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=TIE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=postrapseudos %t/rotate.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=SOURCE
# TIE: contents group requires its actual fixed-register ties
# SOURCE: contents rotate4 requires an allocated SFPU source

#--- copy.mir
--- |
  define void @copy() "tensix-executor"="trisc1" { ret void }
...
---
name: copy
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    $tt_l0, $tt_l1, $tt_l2, $tt_l3 = PseudoTTSFPContentsCopy4 $tt_l0, $tt_l1, $tt_l2, undef $tt_l3, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoRET
...

#--- transpose.mir
--- |
  define void @transpose() "tensix-executor"="trisc1" { ret void }
...
---
name: transpose
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    $tt_l0, $tt_l1, $tt_l2, $tt_l3, $tt_l4, $tt_l5, $tt_l6, $tt_l7 = PseudoTTSFPContentsTranspose8 $tt_l0, $tt_l1, $tt_l2, $tt_l3, $tt_l4, $tt_l5, $tt_l6, undef $tt_l7, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoRET
...

#--- rotate.mir
--- |
  define void @rotate() "tensix-executor"="trisc1" { ret void }
...
---
name: rotate
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    $tt_l0, $tt_l1, $tt_l2, $tt_l3 = PseudoTTSFPContentsRotate4 $tt_l0, $tt_l1, $tt_l2, $tt_l3, undef $tt_l0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoRET
...
