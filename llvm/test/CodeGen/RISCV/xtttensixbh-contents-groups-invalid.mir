# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=none -verify-machineinstrs %s -o %t.parsed.mir
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=postrapseudos -verify-machineinstrs %s -o /dev/null 2>&1 | FileCheck %s
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -start-before=postrapseudos -verify-machineinstrs -filetype=obj %s -o %t.o 2>&1 | FileCheck %s
# RUN: test ! -e %t.o

# Correct singleton classes pass initial MIR verification, but an undef use
# does not supply the actual numerical contents required by the fixed group.
# The final expansion must reject it without inventing a value, erasing the
# pseudo's real definitions and uses, or publishing a native instruction.
# CHECK: contents group requires its actual fixed-register ties
--- |
  define void @undefined_group() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: undefined_group
tracksRegLiveness: true
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    liveins: $tt_l0, $tt_l1, $tt_l2, $tt_cc, $tt_config, $tt_issue
    $tt_l0, $tt_l1, $tt_l2, $tt_l3 = PseudoTTSFPContentsCopy4 $tt_l0, $tt_l1, $tt_l2, undef $tt_l3, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoRET implicit $tt_l0, implicit $tt_l1, implicit $tt_l2, implicit $tt_l3
...
