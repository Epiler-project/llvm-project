# RUN: split-file %s %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/safe.mir -o /dev/null
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/short.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DRAIN
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/wait.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DRAIN
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/math.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=ADDRESS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/base.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=ADDRESS
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/sequence.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=CONFIG
# RUN: not --crash llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/high.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=REGISTER
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/effects.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=EFFECT
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/spoof.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=ADDRESS
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/fixed-stack.mir -o /dev/null
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/unknown-store.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=ACTIVE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixwh -run-pass=riscv-tensix-hazards %t/bad-wait.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=WAIT_FIELD

# A normal SFPU wait cannot drain instruction-driven delayed macro queues.
# Final reception independently checks real setup, template words, low-half
# allocation, declared effects and the actual emitted finite drain.
# ADDRESS: actual zero Dst address setup on every incoming path
# CONFIG: actual ADDI template, sequence and FP32 misc configuration
# DRAIN: four actual consecutive SFPNOP load-unit drain issues
# Missing native implicit state is rejected by the MIR parser itself.
# EFFECT: missing implicit register operand 'implicit $tt_dst'
# The native descriptor rejects the high-half register at MIR ingress.
# REGISTER: $tt_l5 is not a SFPRLow register.
# ACTIVE: all-active zero LaneConfig
# WAIT_FIELD: Wormhole STALLWAIT field wait_res must be in [0, 32767]

#--- safe.mir
--- |
  define void @safe() "target-features"="+xtttensixwh" "tensix-executor"="trisc1" "tensix-macro-address-ready"="true" { ret void }
...
---
name: safe
tracksRegLiveness: false
body: |
  bb.0:
    TTSETC16 0, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETC16 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTRMWCIB0 6, 0, 255, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTRMWCIB1 6, 0, 255, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETC16 0, 23, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETC16 0, 27, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETRWC 4, 0, 0, 0, 0, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSFPENCC 3, 10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue, implicit-def $tt_cc
    TTSFPCONFIGReset implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPLOADI undef $tt_l0, 30015, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPLOADI $tt_l0, 32768, 10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    TTSFPCONFIGMacroTemplate 0, implicit $tt_l0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPLOADI undef $tt_l0, 4864, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    $tt_l0 = TTSFPLOADI $tt_l0, 1024, 10, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    TTSFPCONFIGMacroSequence 0, implicit $tt_l0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    TTSFPCONFIGMacroMisc 3, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    TTSTALLWAIT 16384, 511, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTNOP implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l1 = TTSFPLOADMACROFP32Even $tt_l1, 8, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_dst, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    TTSFPNOP implicit $tt_issue, implicit-def $tt_issue
    PseudoRET
...

