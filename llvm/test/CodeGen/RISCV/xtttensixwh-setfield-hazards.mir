tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
body: |
  bb.0:
    $tt_l0 = TTSFPMAD $tt_l0, $tt_l2, $tt_l3, $tt_l4, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
