# WH-NEXT: TTSFPNOP
# WH-NEXT: $tt_l0 = TTSFPSETEXP $tt_l0, $tt_l1, 0, 0, implicit $tt_cc, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
