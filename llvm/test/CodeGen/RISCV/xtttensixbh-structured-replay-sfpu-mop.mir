#--- inner_one_mode_only_replay_slot.mir
--- |
  define void @inner_one_mode_only_replay_slot() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: inner_one_mode_only_replay_slot
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
body: |
  bb.0:
    TTREPLAY 1, 0, 1, 0, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l0 = TTSFPMOVAll $tt_l1, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    TTREPLAY 1, 0, 1, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    $tt_l2 = TTSFPMOVAll $tt_l3, implicit $tt_config, implicit $tt_issue, implicit-def $tt_issue
    PseudoTTReplayRecordEnd implicit $tt_issue, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTMOPControlWriteImm 0, 1, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue :: (volatile store (s32))
    early-clobber $x5, early-clobber $x6 = PseudoTTMOPControlWriteImm 1, 1, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue :: (volatile store (s32))
    early-clobber $x5, early-clobber $x6 = PseudoTTMOPClear 2, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTMOPClear 3, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTMOPClear 4, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTREPLAYMop 5, 0, 0, 1, 0, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTREPLAYMop 6, 0, 0, 1, 31, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTREPLAYMop 7, 0, 0, 1, 1, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    early-clobber $x5, early-clobber $x6 = PseudoTTMOPClear 8, implicit $tt_config, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_issue
    TTMOP 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...


#--- raw_cross_slot_hazard.mir
--- |
  define void @raw_cross_slot_hazard() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: raw_cross_slot_hazard
tracksRegLiveness: false
machineFunctionInfo:
  usesTensixSFPU: true
  usesBoundTensixSFPU: true
