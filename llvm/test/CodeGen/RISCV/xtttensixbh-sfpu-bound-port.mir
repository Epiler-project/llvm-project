body: |
  bb.0:
    early-clobber $tt_l0, early-clobber $x6, early-clobber $x7 = PseudoTTSETADCPort 0, $x10, $x11, $x12, $x13, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...

