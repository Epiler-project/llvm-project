#--- check-issues.py
import re
import sys
from pathlib import Path


def functions(path):
    result = {}
    name = None
    body = False
    for line in Path(path).read_text().splitlines():
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
            result[name] = []
        elif line.startswith("body:"):
            body = True
        elif line == "...":
            body = False
        elif body:
            match = re.match(
                r"\s*(TTSETADC|TTREPLAY|PseudoTTReplayRecordEnd|PseudoRET)\b(.*)",
                line,
            )
            if match:
                opcode, rest = match.groups()
                fields = rest.split("implicit", 1)[0].strip().rstrip(",")
                operands = tuple(map(int, fields.split(","))) if fields else ()
                result[name].append((opcode, operands))
            else:
                assert not line.strip() or re.match(r"\s*bb\.\d+:$", line), line
    return result


def execute(instructions):
    # Model only the hardware replay bank and the observable issue sequence.
    # This deliberately does not reproduce candidate discovery or scoring.
    bank = [None] * 32
    active = None
    issues = []
    words = 0
    recordings = []
    for opcode, operands in instructions:
        if opcode == "TTREPLAY":
            words += 1
            load, execute_loading, length, start = operands
            assert active is None
            assert 0 < length <= 32 - start and 0 <= start < 32
            if load:
                assert load == 1
                active = (start, length, bool(execute_loading), [])
                recordings.append(length)
            else:
                recorded = bank[start : start + length]
                assert all(issue is not None for issue in recorded)
                issues.extend(recorded)
        elif opcode == "TTSETADC":
            words += 1
            issue = (opcode, operands)
            if active is None:
                issues.append(issue)
            else:
                active[3].append(issue)
                assert len(active[3]) <= active[1]
                if active[2]:
                    issues.append(issue)
        elif opcode == "PseudoTTReplayRecordEnd":
            assert active is not None
            start, length, _, recorded = active
            assert len(recorded) == length
            bank[start : start + length] = recorded
            active = None
        elif opcode == "PseudoRET":
            assert active is None
    assert active is None
    return issues, words, recordings


source, selected, plain = map(functions, sys.argv[1:])
assert source.keys() == selected.keys() == plain.keys()
for name, original in source.items():
    before, original_words, _ = execute(original)
    after, selected_words, recordings = execute(selected[name])
    disabled, disabled_words, disabled_recordings = execute(plain[name])
    assert after == before, (name, "replay changed issue order or count")
    assert disabled == before and disabled_words == original_words
    assert not disabled_recordings
    if name in ("single_word_repeat", "break_even_pair"):
        assert selected_words == original_words and not recordings
    else:
        assert selected_words < original_words and recordings
        if name == "capacity_32":
            assert 32 in recordings
    print(f"{name}: {original_words} -> {selected_words} words; "
          f"{len(after)} ordered issues preserved")
