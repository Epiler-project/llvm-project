# RUN: split-file %s %t
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-replay-selection %t/selection.mir -o %t/selected.mir
# RUN: FileCheck %s --check-prefix=SELECT < %t/selected.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -riscv-tensix-enable-replay-selection=false -run-pass=riscv-tensix-replay-selection %t/selection.mir -o %t/plain.mir
# RUN: %python %t/check-issues.py %t/selection.mir %t/selected.mir %t/plain.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -start-before=riscv-tensix-hazards -stop-after=riscv-tensix-hazards,1 %t/selected.mir -o %t/final.mir
# RUN: %python %t/check-issues.py %t/selection.mir %t/final.mir %t/plain.mir
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -start-before=riscv-tensix-hazards %t/selected.mir -o /dev/null
# RUN: llc -mtriple=riscv32 -mattr=+xtttensixbh -verify-machineinstrs -start-before=riscv-tensix-hazards %t/explicit-capacity.mir -o /dev/null
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/too-long.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RANGE
# RUN: not llc -mtriple=riscv32 -mattr=+xtttensixbh -run-pass=riscv-tensix-hazards %t/past-bank-end.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RANGE
#
# Two copies of a one-word sequence would grow; a two-word pair only breaks
# even after record/execute overhead. Both must keep their original issues.
# SELECT-LABEL: name: single_word_repeat
# SELECT-NOT: TTREPLAY
# SELECT: TTSETADC 0, 0, 0, 1
# SELECT-NEXT: TTSETADC 0, 0, 0, 1
# SELECT-NEXT: PseudoRET
# SELECT-LABEL: name: break_even_pair
# SELECT-NOT: TTREPLAY
# SELECT: TTSETADC 0, 0, 0, 1
# SELECT-NEXT: TTSETADC 1, 0, 0, 1
# SELECT-NEXT: TTSETADC 0, 0, 0, 1
# SELECT-NEXT: TTSETADC 1, 0, 0, 1
# SELECT-NEXT: PseudoRET
#
# Unique operands prevent a smaller repeating motif from hiding the 32-slot
# capacity edge. The independent issue checker below compares the complete
# replay-expanded execution against the original sequence for both 32 and 33
# words. It permits any profitable legal window in the 33-word case.
# SELECT-LABEL: name: capacity_32
# SELECT: TTREPLAY 1, 1, 32, 0
# SELECT-COUNT-32: TTSETADC
# SELECT-NEXT: PseudoTTReplayRecordEnd
# SELECT-NEXT: TTREPLAY 0, 0, 32, 0
# SELECT-NEXT: PseudoRET
# SELECT-LABEL: name: over_capacity_33
# SELECT: TTREPLAY 1, 1,
# RANGE: Tensix replay range must fit 32 instruction slots

#--- selection.mir
--- |
  define void @single_word_repeat() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @break_even_pair() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @capacity_32() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
  define void @over_capacity_33() "target-features"="+xtttensixbh" "tensix-executor"="trisc1" { ret void }
...
---
name: single_word_repeat
tracksRegLiveness: false
body: |
  bb.0:
    TTSETADC 0, 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETADC 0, 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...
---
name: break_even_pair
tracksRegLiveness: false
body: |
  bb.0:
    TTSETADC 0, 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETADC 1, 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETADC 0, 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    TTSETADC 1, 0, 0, 1, implicit $tt_config, implicit $tt_dst, implicit $tt_issue, implicit-def $tt_config, implicit-def $tt_dst, implicit-def $tt_issue
    PseudoRET
...
---
