# RUN: not llc -mtriple=riscv64 -mattr=+v -run-pass=riscv-register-contents-allocation,greedy %s -o /dev/null 2>&1 | FileCheck %s
# CHECK: ran out of registers during register allocation
# Splat pseudos are ordinarily rematerializable. These 33 contents values must
# remain real simultaneously live VRs; no recomputation or stack storage may
# turn a 32-register file into additional capacity.
--- |
  define void @contents_pressure() #0 { ret void }
  attributes #0 = { "trex-bosc-contents-rvv"="1" }
...
---
name: contents_pressure
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11
    %33:gprnox0 = COPY $x10
    %34:gpr = COPY $x11
    %0:vr = PseudoVMV_V_I_M1 undef %0, 0, %33, 5, 3, implicit $vl, implicit $vtype
    %1:vr = PseudoVMV_V_I_M1 undef %1, 1, %33, 5, 3, implicit $vl, implicit $vtype
    %2:vr = PseudoVMV_V_I_M1 undef %2, 2, %33, 5, 3, implicit $vl, implicit $vtype
    %3:vr = PseudoVMV_V_I_M1 undef %3, 3, %33, 5, 3, implicit $vl, implicit $vtype
    %4:vr = PseudoVMV_V_I_M1 undef %4, 4, %33, 5, 3, implicit $vl, implicit $vtype
    %5:vr = PseudoVMV_V_I_M1 undef %5, 5, %33, 5, 3, implicit $vl, implicit $vtype
    %6:vr = PseudoVMV_V_I_M1 undef %6, 6, %33, 5, 3, implicit $vl, implicit $vtype
    %7:vr = PseudoVMV_V_I_M1 undef %7, 7, %33, 5, 3, implicit $vl, implicit $vtype
    %8:vr = PseudoVMV_V_I_M1 undef %8, 8, %33, 5, 3, implicit $vl, implicit $vtype
    %9:vr = PseudoVMV_V_I_M1 undef %9, 9, %33, 5, 3, implicit $vl, implicit $vtype
    %10:vr = PseudoVMV_V_I_M1 undef %10, 10, %33, 5, 3, implicit $vl, implicit $vtype
    %11:vr = PseudoVMV_V_I_M1 undef %11, 11, %33, 5, 3, implicit $vl, implicit $vtype
    %12:vr = PseudoVMV_V_I_M1 undef %12, 12, %33, 5, 3, implicit $vl, implicit $vtype
    %13:vr = PseudoVMV_V_I_M1 undef %13, 13, %33, 5, 3, implicit $vl, implicit $vtype
    %14:vr = PseudoVMV_V_I_M1 undef %14, 14, %33, 5, 3, implicit $vl, implicit $vtype
    %15:vr = PseudoVMV_V_I_M1 undef %15, 15, %33, 5, 3, implicit $vl, implicit $vtype
    %16:vr = PseudoVMV_V_I_M1 undef %16, 0, %33, 5, 3, implicit $vl, implicit $vtype
    %17:vr = PseudoVMV_V_I_M1 undef %17, 1, %33, 5, 3, implicit $vl, implicit $vtype
    %18:vr = PseudoVMV_V_I_M1 undef %18, 2, %33, 5, 3, implicit $vl, implicit $vtype
    %19:vr = PseudoVMV_V_I_M1 undef %19, 3, %33, 5, 3, implicit $vl, implicit $vtype
    %20:vr = PseudoVMV_V_I_M1 undef %20, 4, %33, 5, 3, implicit $vl, implicit $vtype
    %21:vr = PseudoVMV_V_I_M1 undef %21, 5, %33, 5, 3, implicit $vl, implicit $vtype
    %22:vr = PseudoVMV_V_I_M1 undef %22, 6, %33, 5, 3, implicit $vl, implicit $vtype
    %23:vr = PseudoVMV_V_I_M1 undef %23, 7, %33, 5, 3, implicit $vl, implicit $vtype
    %24:vr = PseudoVMV_V_I_M1 undef %24, 8, %33, 5, 3, implicit $vl, implicit $vtype
    %25:vr = PseudoVMV_V_I_M1 undef %25, 9, %33, 5, 3, implicit $vl, implicit $vtype
    %26:vr = PseudoVMV_V_I_M1 undef %26, 10, %33, 5, 3, implicit $vl, implicit $vtype
