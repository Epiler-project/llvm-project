    %31:vr = PseudoVMV_V_I_M1 undef %31, 15, %33, 5, 3, implicit $vl, implicit $vtype
    %32:vr = PseudoVMV_V_I_M1 undef %32, 0, %33, 5, 3, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %0, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %1, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %2, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %3, %34, %33, 5, implicit $vl, implicit $vtype
