    PseudoVSE32_V_M1 killed %17, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %18, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %19, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %20, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %21, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %22, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %23, %34, %33, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 killed %24, %34, %33, 5, implicit $vl, implicit $vtype
