# RUN: not llc -mtriple=riscv64 -mattr=+v -run-pass=postrapseudos -verify-machineinstrs %s -o /dev/null 2>&1 | FileCheck %s
# RUN: not llc -mtriple=riscv64 -mattr=+v -start-before=postrapseudos -verify-machineinstrs -filetype=obj %s -o %t.o 2>&1 | FileCheck %s
# RUN: test ! -e %t.o
# A PHI/two-address repair that survives coalescing may not silently move
# register-backed Buffer contents. Ordinary RISC-V COPY remains supported.
# CHECK: BOSC register contents cannot synthesize a vector register copy
--- |
  define void @contents_copy() #0 { ret void }
  attributes #0 = { "trex-bosc-contents-rvv"="1" }
...
---
name: contents_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8
    $v9 = COPY $v8
    PseudoRET implicit $v9
...
