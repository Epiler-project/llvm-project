# RUN: split-file %s %t
# RUN: llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-predecessor.mir -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/entry-control.mir -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-operations.mir -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-selector-predecessor.mir -o /dev/null
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/reachable-missing-k.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=CONFIG
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/reachable-undefined-acc.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=UNDEFINED
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-missing-dependency.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DEPENDENCY
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/reachable-selector-clobber.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=SELECTOR
# CONFIG: machine operation requires M/N/K on every incoming path
# UNDEFINED: machine read of undefined physical AME register
# DEPENDENCY: missing implicit register operand 'implicit $bosc_k'
# SELECTOR: machine selected MMA requires initialized C/A and the same live B selector
#
# Only paths reachable from the real entry contribute execution state. Dead
# predecessors cannot poison either dimension or scalar selector facts. Static
# instruction/dependency checks still cover dead blocks; live path failures remain.

# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-selected-load-same.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DISTINCT
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-selected-load-out-of-range.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RANGE
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-selected-mma-same.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=DISTINCT
# RUN: not llc -mtriple=riscv64 -mattr=+xboscame -run-pass=riscv-bosc-bound-verify %t/dead-selected-mma-out-of-range.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=RANGE
# DISTINCT: selected machine B alternatives require distinct Tr0..Tr15
# RANGE: selected machine B alternative exceeds Tr0..Tr15
#
# Dead blocks skip execution-state checking, but their typed instruction
# alternatives must retain distinctness and range validity. Local config
# isolates these structural diagnostics on the frozen predecessor as well.

#--- dead-predecessor.mir
--- |
  define void @dead_predecessor() "trex-bosc-bound-ame"="1" { ret void }
...
---
name: dead_predecessor
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.2
    $x5 = BOSC_AME_SETM $x10, implicit-def $bosc_m, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETN $x10, implicit-def $bosc_n, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETK $x10, implicit-def $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    PseudoBR %bb.2
  bb.2:
    $bosc_acc0 = BOSC_AME_LOADC $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoRET
...

#--- entry-control.mir
--- |
  define void @entry_control() "trex-bosc-bound-ame"="1" { ret void }
...
---
name: entry_control
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.1
    $x5 = BOSC_AME_SETM $x10, implicit-def $bosc_m, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETN $x10, implicit-def $bosc_n, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETK $x10, implicit-def $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoBR %bb.1
  bb.1:
    $bosc_acc0 = BOSC_AME_LOADC $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoRET
...

#--- dead-operations.mir
--- |
  define void @dead_operations() "trex-bosc-bound-ame"="1" { ret void }
...
---
name: dead_operations
tracksRegLiveness: false
body: |
  bb.0:
    PseudoRET
  bb.1:
    $bosc_acc0 = BOSC_AME_LOADC $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    BOSC_AME_STOREC $bosc_acc0, $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoRET
...

#--- dead-selector-predecessor.mir
--- |
  define void @dead_selector_predecessor() "trex-bosc-bound-ame"="1" { ret void }
...
---
name: dead_selector_predecessor
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.2
    $x13 = ANDI $x12, 1
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    $x13 = XORI $x12, 1
    PseudoBR %bb.2
  bb.2:
    $x5 = BOSC_AME_SETM $x10, implicit-def $bosc_m, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETN $x10, implicit-def $bosc_n, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETK $x10, implicit-def $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    $bosc_acc0 = BOSC_AME_LOADC $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    $bosc_tr0 = BOSC_AME_LOADA $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoBOSCAMELoadBSelectBound $x13, 1, 2, $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit-def $bosc_tr1, implicit-def $bosc_tr2, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoBOSCAMEMMABSelectBound 0, 0, $x13, 1, 2, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_tr1, implicit $bosc_tr2, implicit $bosc_acc0, implicit-def $bosc_acc0, implicit $bosc_tr0, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoRET
...

#--- reachable-missing-k.mir
--- |
  define void @reachable_missing_k() "trex-bosc-bound-ame"="1" { ret void }
...
---
name: reachable_missing_k
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    $x5 = BOSC_AME_SETM $x10, implicit-def $bosc_m, implicit $bosc_issue, implicit-def $bosc_issue
    $x5 = BOSC_AME_SETN $x10, implicit-def $bosc_n, implicit $bosc_issue, implicit-def $bosc_issue
    BNE $x14, $x0, %bb.1
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    $x5 = BOSC_AME_SETK $x10, implicit-def $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoBR %bb.2
  bb.2:
    $bosc_acc0 = BOSC_AME_LOADC $x10, $x11, implicit $bosc_m, implicit $bosc_n, implicit $bosc_k, implicit $bosc_issue, implicit-def $bosc_issue
    PseudoRET
...

