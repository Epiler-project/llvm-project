# TableGen writes exactly one target followed by a colon and whitespace.
# Locate that delimiter, rather than a drive-letter colon, and preserve the
# dependency text verbatim. Quote the replacement as a make depfile token.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "RewriteTableGenDepfile.cmake requires INPUT and OUTPUT")
endif()
if(NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "TableGen did not produce depfile: ${INPUT}")
endif()
file(READ "${INPUT}" _contents)
string(REGEX MATCH ":[ \t\r\n]" _delimiter "${_contents}")
if(NOT _delimiter)
  message(FATAL_ERROR "TableGen depfile has no target delimiter: ${INPUT}")
endif()
string(FIND "${_contents}" "${_delimiter}" _end)
math(EXPR _end "${_end} + 1")
string(SUBSTRING "${_contents}" ${_end} -1 _dependencies)
string(REPLACE "\\" "/" _target "${OUTPUT}")
string(REPLACE "$" "$$" _target "${_target}")
string(REPLACE "#" "\\#" _target "${_target}")
string(REPLACE " " "\\ " _target "${_target}")
if(PRIMARY_INPUT)
  string(REPLACE "\\" "/" _primary "${PRIMARY_INPUT}")
  string(REPLACE "$" "$$" _primary "${_primary}")
  string(REPLACE "#" "\\#" _primary "${_primary}")
  string(REPLACE " " "\\ " _primary "${_primary}")
  string(REGEX REPLACE "[\r\n]+$" "" _dependencies "${_dependencies}")
  string(FIND " ${_dependencies} " " ${_primary} " _primary_position)
  if(_primary_position EQUAL -1)
    string(APPEND _dependencies " ${_primary}")
  endif()
  string(APPEND _dependencies "\n")
endif()
file(WRITE "${INPUT}" "${_target}:${_dependencies}")
