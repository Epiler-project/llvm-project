# Only Make needs this rule: Ninja tracks missing byproducts natively.
# Separate recovery rules for a multi-output generator share a lock, so one
# invocation restores the set and the remaining rules observe its outputs.
if(NOT DEFINED REQUIRED_OUTPUT OR NOT DEFINED STAMP)
  message(FATAL_ERROR "TableGen recovery requires REQUIRED_OUTPUT and STAMP")
endif()
file(LOCK "${STAMP}.lock" GUARD PROCESS)
if(EXISTS "${REQUIRED_OUTPUT}")
  return()
endif()
set(_command)
set(_collect OFF)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_index RANGE 0 ${_last})
  if(_collect)
    list(APPEND _command "${CMAKE_ARGV${_index}}")
  elseif(CMAKE_ARGV${_index} STREQUAL "--")
    set(_collect ON)
  endif()
endforeach()
if(NOT _command)
  message(FATAL_ERROR "TableGen recovery has no generator command")
endif()
execute_process(COMMAND ${_command} RESULT_VARIABLE _result)
if(NOT _result STREQUAL "0")
  message(FATAL_ERROR "TableGen recovery failed: ${_result}")
endif()
if(NOT EXISTS "${REQUIRED_OUTPUT}")
  message(FATAL_ERROR "TableGen did not restore ${REQUIRED_OUTPUT}")
endif()
if(DEPFILE)
  set(INPUT "${DEPFILE}")
  set(OUTPUT "${STAMP}")
  include("${DEPFILE_REWRITER}")
endif()
file(TOUCH "${STAMP}")
